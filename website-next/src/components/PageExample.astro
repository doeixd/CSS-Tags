---
import ExampleWorkbench from "./ExampleWorkbench.astro";
import { getPageExample } from "../data/page-examples";

interface Props {
    currentPath: string;
    pageTitle: string;
}

const { currentPath, pageTitle } = Astro.props;
const example = getPageExample(currentPath, pageTitle);
const id = `page-example-${(currentPath || "home").replace(/[^a-z0-9]+/gi, "-")}`;
const voidElements = new Set(["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"]);

function formatMarkup(value: string) {
    const tokens = value
        .replace(/>\s+</g, "><")
        .replace(/></g, ">\n<")
        .split("\n")
        .map((token) => token.trim())
        .filter(Boolean);
    let depth = 0;

    return tokens.map((token) => {
        if (/^<\//.test(token)) depth = Math.max(0, depth - 1);
        const line = `${"  ".repeat(depth)}${token}`;
        const opening = token.match(/^<([a-z][\w-]*)\b/i);
        const closesOnLine = opening && new RegExp(`<\\/${opening[1]}>\\s*$`, "i").test(token);
        const selfClosing = /\/>$/.test(token) || (opening && voidElements.has(opening[1].toLowerCase()));
        if (opening && !closesOnLine && !selfClosing) depth += 1;
        return line;
    }).join("\n");
}

function scopeMarkup(value: string, suffix: string) {
    const ids = Array.from(value.matchAll(/\bid="([^"]+)"/g), (match) => match[1]);
    return ids.reduce((source, oldId) => {
        const nextId = `${oldId}-${suffix}`;
        return source
            .replaceAll(`id="${oldId}"`, `id="${nextId}"`)
            .replaceAll(`aria-controls="${oldId}"`, `aria-controls="${nextId}"`)
            .replaceAll(`aria-describedby="${oldId}"`, `aria-describedby="${nextId}"`)
            .replaceAll(`aria-labelledby="${oldId}"`, `aria-labelledby="${nextId}"`)
            .replaceAll(`for="${oldId}"`, `for="${nextId}"`)
            .replaceAll(`popovertarget="${oldId}"`, `popovertarget="${nextId}"`)
            .replaceAll(`href="#${oldId}"`, `href="#${nextId}"`);
    }, value);
}

function wrapSource(wrapper: string, source: string) {
    const closing = wrapper.startsWith("<section") ? "</section>" : "</div>";
    return `${wrapper}\n${formatMarkup(source).split("\n").map((line) => `  ${line}`).join("\n")}\n${closing}`;
}

function inferSourceLanguage(source: string) {
    const trimmed = source.trim();
    if (trimmed.startsWith("---")) return { language: "astro", label: "Astro" };
    if (/^(?:\/\/|interface\b|type\b|const\b|export\b)/.test(trimmed) && /(?:CSSTags|<[A-Z]|:\s*[A-Z]\w*)/.test(trimmed)) {
        return { language: "tsx", label: "TypeScript" };
    }
    if (!trimmed.startsWith("<") && trimmed.includes("{") && trimmed.includes("}")) {
        return { language: "css", label: "CSS" };
    }
    return { language: "html", label: "HTML" };
}

const sourceType = inferSourceLanguage(example.code);
const compactMarkup = scopeMarkup(example.preview, "compact");
const themedMarkup = scopeMarkup(example.preview, "themed");
const additionalExamples = example.additionalExamples
    ? example.additionalExamples.map((additional, index) => {
        const source = inferSourceLanguage(additional.code);
        return {
            id: `${id}-additional-${index + 1}`,
            title: additional.title,
            description: additional.description,
            markup: scopeMarkup(additional.preview, `additional-${index + 1}`),
            markupSource: additional.code,
            markupLanguage: source.language,
            markupLabel: source.label,
            compact: additional.compact ?? false,
        };
    })
    : [];
---

<section aria-label="Quick example">
    <ExampleWorkbench
        id={id}
        title={example.title}
        description={example.description}
        markup={example.preview}
        markupSource={example.code}
        markupLanguage={sourceType.language}
        markupLabel={sourceType.label}
    />

    <h2>More examples</h2>
    <p>{example.additionalExamples
        ? "Each example introduces a different part of the shipped API."
        : "The focused example above demonstrates the API used on this page."}</p>

    {additionalExamples.map((additional) => (
        <ExampleWorkbench
            id={additional.id}
            title={additional.title}
            description={additional.description}
            markup={additional.markup}
            markupSource={additional.markupSource}
            markupLanguage={additional.markupLanguage}
            markupLabel={additional.markupLabel}
            compact={additional.compact}
        />
    ))}
</section>

<script>
    import { initializeCarousels } from "../../../carousel.js";
    import { initializeViewTransitions } from "../../../view-transition.js";

    function initializeTabs(root: Document | ShadowRoot | HTMLElement) {
        root.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((tablist) => {
            if (tablist.dataset.tabsReady === "true") return;
            const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
            if (!tabs.length) return;
            tablist.dataset.tabsReady = "true";
            tablist.dataset.tabsEnhanced = "true";

            const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
            const select = (tab: HTMLButtonElement, moveFocus = false) => {
                if (tab.disabled || tab.getAttribute("aria-disabled") === "true") return;
                const panelId = tab.getAttribute("aria-controls");
                tabs.forEach((candidate) => {
                    const selected = candidate === tab;
                    candidate.setAttribute("aria-selected", String(selected));
                    candidate.tabIndex = selected ? 0 : -1;
                });
                panels.forEach((panel) => {
                    if (panelId && panel.id === panelId) panel.removeAttribute("hidden");
                    else if (panel.getAttribute("aria-labelledby") && tabs.some((candidate) => candidate.getAttribute("aria-controls") === panel.id)) panel.hidden = true;
                });
                if (moveFocus) tab.focus();
            };

            const selected = tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ?? tabs[0];
            select(selected);
            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => select(tab));
                tab.addEventListener("keydown", (event) => {
                    const orientation = tablist.getAttribute("aria-orientation") === "vertical" ? "vertical" : "horizontal";
                    const forward = orientation === "vertical" ? "ArrowDown" : "ArrowRight";
                    const backward = orientation === "vertical" ? "ArrowUp" : "ArrowLeft";
                    let nextIndex = index;
                    if (event.key === forward) nextIndex = (index + 1) % tabs.length;
                    else if (event.key === backward) nextIndex = (index - 1 + tabs.length) % tabs.length;
                    else if (event.key === "Home") nextIndex = 0;
                    else if (event.key === "End") nextIndex = tabs.length - 1;
                    else return;
                    event.preventDefault();
                    select(tabs[nextIndex], true);
                });
            });
        });
    }

    function initializeSortableTables(root: Document | ShadowRoot | HTMLElement) {
        root.querySelectorAll<HTMLTableElement>("table[data-sortable]").forEach((table) => {
            if (table.dataset.sortReady === "true") return;
            table.dataset.sortReady = "true";

            table.querySelectorAll<HTMLButtonElement>("thead button[data-table-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const header = button.closest<HTMLTableCellElement>("th");
                    const body = table.tBodies.item(0);
                    if (!header || !body || !header.parentElement) return;

                    const columnIndex = Array.from(header.parentElement.cells).indexOf(header);
                    const direction = header.getAttribute("aria-sort") === "ascending"
                        ? "descending"
                        : "ascending";
                    const factor = direction === "ascending" ? 1 : -1;
                    const numeric = button.dataset.sortType === "number";
                    const rows = Array.from(body.rows);

                    table.querySelectorAll("thead th[aria-sort]").forEach((candidate) => {
                        candidate.removeAttribute("aria-sort");
                    });
                    header.setAttribute("aria-sort", direction);

                    rows.sort((left, right) => {
                        const leftCell = left.cells.item(columnIndex);
                        const rightCell = right.cells.item(columnIndex);
                        const leftValue = leftCell?.dataset.sortValue ?? leftCell?.textContent?.trim() ?? "";
                        const rightValue = rightCell?.dataset.sortValue ?? rightCell?.textContent?.trim() ?? "";
                        if (numeric) return (Number(leftValue) - Number(rightValue)) * factor;
                        return leftValue.localeCompare(rightValue, undefined, { numeric: true }) * factor;
                    });

                    body.append(...rows);
                });
            });
        });
    }

    function setupQuickExamples() {
        document.querySelectorAll<HTMLElement>("css-tags-example").forEach((host) => {
            const root = host.shadowRoot;
            if (!root) return;

            initializeCarousels(root);
            initializeViewTransitions(root);
            initializeTabs(root);
            initializeSortableTables(root);

            root.querySelectorAll<HTMLElement>("[data-doc-nav]").forEach((nav) => {
                if (nav.dataset.ready === "true") return;
                nav.dataset.ready = "true";
                const toggle = nav.querySelector<HTMLButtonElement>(".nav-toggle");
                const links = nav.querySelector<HTMLElement>(".nav-links");
                toggle?.addEventListener("click", () => {
                    const expanded = toggle.getAttribute("aria-expanded") === "true";
                    toggle.setAttribute("aria-expanded", String(!expanded));
                    links?.classList.toggle("active", !expanded);
                });
            });

            root.querySelectorAll<HTMLElement>("[data-doc-view-transition]").forEach((demo) => {
                if (demo.dataset.ready === "true") return;
                demo.dataset.ready = "true";
                demo.querySelectorAll<HTMLButtonElement>("[data-doc-page]").forEach((button) => {
                    button.addEventListener("click", () => {
                        const update = () => {
                            demo.querySelectorAll<HTMLElement>(":is(view-page, [data-view-page], .view-page)").forEach((page) => {
                                page.toggleAttribute("active", page.id === button.dataset.docPage);
                            });
                        };
                        if (document.startViewTransition) document.startViewTransition(update);
                        else update();
                    });
                });
            });
        });
    }

    document.addEventListener("DOMContentLoaded", setupQuickExamples);
    document.addEventListener("astro:page-load", setupQuickExamples);
    document.addEventListener("workbench:preview-reset", setupQuickExamples);
</script>
