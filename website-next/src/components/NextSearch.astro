---
import "@pagefind/default-ui/css/ui.css";

const base = import.meta.env.BASE_URL;
---

<details class="next-docs-search" data-docs-search data-disclosure="flush" data-base={base}>
  <summary>
    <svg class="next-docs-search__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5" />
      <path d="m12.5 12.5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <span>Search</span>
    <kbd aria-hidden="true">Ctrl K</kbd>
  </summary>
  <div data-docs-search-panel>
    <div id="next-docs-search"></div>
    <p class="caption" data-docs-search-status aria-live="polite"></p>
  </div>
</details>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  const setupDocsSearch = () => {
    const details = document.querySelector<HTMLDetailsElement>("[data-docs-search]");
    const mount = document.querySelector<HTMLElement>("#next-docs-search");
    const status = details?.querySelector<HTMLElement>("[data-docs-search-status]");
    if (!details || !mount || details.dataset.ready === "true") return;
    details.dataset.ready = "true";

    const base = details.dataset.base ?? "/";
    try {
      new PagefindUI({
        element: "#next-docs-search",
        showImages: false,
        showSubResults: false,
        excerptLength: 24,
        baseUrl: base,
        bundlePath: `${base.replace(/\/$/, "")}/pagefind/`,
        processResult: (result) => {
          if (result.excerpt) result.excerpt = result.excerpt.replace(/<[^>]*>/g, "");
          if (result.url) {
            const prefix = base.replace(/\/$/, "");
            const path = `/${result.url.replace(/^\/+/, "")}`;
            result.url = prefix && !path.startsWith(`${prefix}/`) ? `${prefix}${path}` : path;
          }
          return result;
        },
      });
    } catch {
      if (status) status.textContent = "Search is unavailable. Use the documentation menu instead.";
    }

    details.addEventListener("toggle", () => {
      if (details.open) requestAnimationFrame(() => details.querySelector<HTMLInputElement>("input")?.focus());
    });

    const input = details.querySelector<HTMLInputElement>("input");
    const initialQuery = new URL(location.href).searchParams.get("q");
    if (input && initialQuery) {
      input.value = initialQuery;
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
    input?.addEventListener("input", () => {
      const url = new URL(location.href);
      const query = input.value.trim();
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);
    });

    details.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest(".pagefind-ui__result-link")) {
        details.open = false;
      }
    });

    if (document.documentElement.dataset.docsSearchGlobalReady !== "true") {
      document.documentElement.dataset.docsSearchGlobalReady = "true";
      document.addEventListener("keydown", (event) => {
        const current = document.querySelector<HTMLDetailsElement>("[data-docs-search]");
        if (!current) return;
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          current.open = true;
          requestAnimationFrame(() => current.querySelector<HTMLInputElement>("input")?.focus());
        } else if (event.key === "Escape" && current.open) {
          current.open = false;
          current.querySelector<HTMLElement>("summary")?.focus();
        }
      });
      document.addEventListener("pointerdown", (event) => {
        const current = document.querySelector<HTMLDetailsElement>("[data-docs-search]");
        if (current?.open && event.target instanceof Node && !current.contains(event.target)) current.open = false;
      });
    }
  };

  setupDocsSearch();
  document.addEventListener("astro:page-load", setupDocsSearch);
</script>
