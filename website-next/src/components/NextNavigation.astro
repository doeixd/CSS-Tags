---
import { navigation } from "../navigation";
import { normalizeBase, buildHref } from "../utils/url";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const base = normalizeBase(import.meta.env.BASE_URL);
---

<nav aria-label="Documentation">
  <layout-stack gap="var(--space-sm)">
    {navigation.map((section) => (
      section.items ? (
        <details data-disclosure="flush" open={!section.collapsed || section.items.some((item) => item.slug === currentPath)}>
          <summary>{section.label}</summary>
          <ul data-list-navigation data-variant="flush">
            {section.items
              .filter((item) => item.slug !== undefined)
              .map((item) => (
                <li>
                  <a
                    href={`${buildHref(base, item.slug)}${item.hash ? `#${item.hash}` : ""}`}
                    data-astro-prefetch="hover"
                    aria-current={!item.hash && item.slug === currentPath ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
          </ul>
        </details>
      ) : section.slug ? (
        <a href={buildHref(base, section.slug)} data-astro-prefetch="hover" aria-current={section.slug === currentPath ? "page" : undefined}>
          {section.label}
        </a>
      ) : null
    ))}
  </layout-stack>
</nav>

<script>
  const sidebarScrollKey = "css-tags:docs-sidebar-scroll";

  function revealCurrentNavigationItem() {
    const sidebar = document.querySelector<HTMLElement>(".next-docs__sidebar");
    const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (!sidebar || !current) return;

    requestAnimationFrame(() => {
      const sidebarRect = sidebar.getBoundingClientRect();
      const currentRect = current.getBoundingClientRect();
      const targetOffset = Math.min(sidebar.clientHeight / 3, 12 * 16);
      sidebar.scrollTop += currentRect.top - sidebarRect.top - targetOffset;
    });
  }

  function saveSidebarScrollPosition() {
    const sidebar = document.querySelector<HTMLElement>(".next-docs__sidebar");
    if (!sidebar) return;
    try {
      sessionStorage.setItem(sidebarScrollKey, String(sidebar.scrollTop));
    } catch {
      // Navigation still works when storage is unavailable.
    }
  }

  function restoreSidebarScrollPosition() {
    let savedPosition: number | null = null;
    try {
      const stored = sessionStorage.getItem(sidebarScrollKey);
      if (stored !== null) savedPosition = Number.parseFloat(stored);
    } catch {
      return;
    }
    if (savedPosition === null || !Number.isFinite(savedPosition)) return;
    const position = savedPosition;

    const apply = () => {
      const sidebar = document.querySelector<HTMLElement>(".next-docs__sidebar");
      if (sidebar) sidebar.scrollTop = position;
    };

    // Apply immediately, then again after disclosure/layout measurement has
    // settled so the browser cannot overwrite the restored position.
    apply();
    requestAnimationFrame(() => {
      apply();
      requestAnimationFrame(apply);
    });
  }

  // On a direct visit, place the current page within view. During client-side
  // navigation, preserve the reader's exact position instead of re-centering it.
  let hasSavedSidebarPosition = false;
  try {
    hasSavedSidebarPosition = sessionStorage.getItem(sidebarScrollKey) !== null;
  } catch {
    // Use the direct-visit behavior when storage is unavailable.
  }
  if (hasSavedSidebarPosition) restoreSidebarScrollPosition();
  else revealCurrentNavigationItem();

  if (document.documentElement.dataset.docsSidebarScrollReady !== "true") {
    document.documentElement.dataset.docsSidebarScrollReady = "true";
    document.addEventListener("astro:before-swap", saveSidebarScrollPosition);
    document.addEventListener("astro:after-swap", restoreSidebarScrollPosition);
    document.addEventListener("astro:page-load", restoreSidebarScrollPosition);
  }
</script>
