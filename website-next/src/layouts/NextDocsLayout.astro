---
import "../../../index.css";
import "../styles/docs-site.css";
import { ClientRouter } from "astro:transitions";
import NextNavigation from "../components/NextNavigation.astro";
import NextSearch from "../components/NextSearch.astro";
import NextThemeEditor from "../components/NextThemeEditor.astro";
import { normalizeBase, buildHref } from "../utils/url";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  currentPath: string;
  headings?: Heading[];
}

const { title, description, currentPath, headings = [] } = Astro.props;
const base = normalizeBase(import.meta.env.BASE_URL);
const pageTitle = `${title} | CSS Tags`;
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="x-dns-prefetch-control" content="on" />
    <meta name="description" content={description ?? "CSS Tags documentation"} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="dns-prefetch" href="https://github.com" />
    <script is:inline>
      try {
        const mode = localStorage.getItem("css-tags-color-scheme");
        const resolved = mode === "light" || mode === "dark"
          ? mode
          : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (mode === "light" || mode === "dark") document.documentElement.dataset.colorScheme = mode;
        document.documentElement.dataset.resolvedColorScheme = resolved;
        const allowedThemeVariables = new Set([
          "--accent-h",
          "--accent-c",
          "--accent-l",
          "--surface-saturation",
          "--surface-lightness-shift",
          "--surface-contrast",
          "--secondary-hue-shift",
          "--tertiary-hue-shift",
          "--contrast-factor",
          "--success-h",
          "--warning-h",
          "--error-h",
          "--info-h",
          "--density-factor",
          "--radius-factor",
          "--font-size-prose",
          "--line-height-prose",
          "--measure-prose",
          "--font-size-ui",
          "--font-size-control",
          "--font-weight-heading",
          "--letter-spacing-heading",
        ]);
        const themeOverrides = JSON.parse(localStorage.getItem("css-tags-theme-overrides") ?? "{}");
        let overrideCount = 0;
        if (themeOverrides && typeof themeOverrides === "object" && !Array.isArray(themeOverrides)) {
          Object.entries(themeOverrides).forEach(([name, value]) => {
            if (allowedThemeVariables.has(name) && typeof value === "string") {
              document.documentElement.style.setProperty(name, value);
              overrideCount += 1;
            }
          });
        }
        document.documentElement.dataset.themeOverrides = String(overrideCount);
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <ClientRouter />

    <layout-page min-height="100dvh">
      <header class="site-header" data-sticky data-size="compact" slot="header">
        <container max-width-xl="var(--docs-safe-max-width)">
          <a data-site-brand href={buildHref(base)} data-astro-prefetch="hover">CSS Tags</a>
          <nav data-header-navigation aria-label="Primary">
            <layout-cluster gap="var(--space-md)">
              <a href={buildHref(base, "guides/getting-started")} data-astro-prefetch="hover">Get started</a>
              <a href={buildHref(base, "components/site-shell")} data-astro-prefetch="hover" aria-current={currentPath === "components/site-shell" ? "page" : undefined}>Components</a>
              <a href={buildHref(base, "examples/examples")} data-astro-prefetch="hover">Examples</a>
            </layout-cluster>
          </nav>
          <div data-header-actions>
            <NextSearch />
            <NextThemeEditor />
            <a href="https://github.com/doeixd/CSS-Tags">GitHub</a>
          </div>
        </container>
      </header>

      <div slot="main" class="next-docs__shell">
        <container max-width-xl="var(--docs-safe-max-width)" pad="var(--docs-safe-padding-inline)">
          <layout-sidebar side-width="15rem" content-min-width="min(100%, 38rem)" gap="var(--docs-shell-gap)">
            <aside data-layout-sidebar-aside class="next-docs__sidebar">
              <details class="next-docs__navigation-disclosure" data-disclosure="flush" open>
                <summary>Documentation menu</summary>
                <NextNavigation currentPath={currentPath} />
              </details>
            </aside>

            <layout-sidebar side="right" side-width="12.5rem" content-min-width="min(100%, 36rem)" gap="var(--docs-content-gap)">
              <aside
                data-layout-sidebar-aside
                class="next-docs__outline"
                data-empty={outline.length === 0 ? "true" : undefined}
                aria-hidden={outline.length === 0 ? "true" : undefined}
              >
                {outline.length > 0 && (
                  <nav aria-label="On this page">
                    <strong>On this page</strong>
                    <ul data-list-navigation data-variant="flush">
                      {outline.map((heading) => (
                        <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>
                      ))}
                    </ul>
                  </nav>
                )}
              </aside>

              <main id="main-content" tabindex="-1" data-pagefind-body class="next-docs__content">
                <slot />
              </main>
            </layout-sidebar>
          </layout-sidebar>
        </container>
      </div>

      <footer class="site-footer" data-bordered data-size="compact" slot="footer">
        <container max-width-xl="var(--docs-safe-max-width)">
          <div data-footer-meta>
            <span>CSS Tags documentation</span>
            <span>Built with the shipped CSS Tags library</span>
          </div>
        </container>
      </footer>
    </layout-page>
  </body>
</html>

<script>
  const setupNavigationDisclosure = () => {
    const disclosure = document.querySelector<HTMLDetailsElement>(".next-docs__navigation-disclosure");
    if (!disclosure || disclosure.dataset.ready === "true") return;
    const wide = window.matchMedia("(min-width: 64.001rem)");
    const sync = () => { disclosure.open = wide.matches; };
    sync();
    disclosure.dataset.ready = "true";
    wide.addEventListener("change", sync);
  };

  setupNavigationDisclosure();
  document.addEventListener("astro:page-load", setupNavigationDisclosure);

  const updateOutline = () => {
    const outline = document.querySelector<HTMLElement>(".next-docs__outline");
    const links = Array.from(outline?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []);
    const targets = links
      .map((link) => ({ link, heading: document.getElementById(link.hash.slice(1)) }))
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item.heading !== null);
    if (!outline || targets.length === 0) return;
    const offset = window.scrollY + 120;
    let active = targets[0];
    for (const target of targets) {
      if (target.heading.offsetTop <= offset) active = target;
      else break;
    }
    targets.forEach(({ link }) => link.removeAttribute("aria-current"));
    active.link.setAttribute("aria-current", "location");

    const linkTop = active.link.offsetTop;
    const visibleTop = outline.scrollTop;
    const visibleBottom = visibleTop + outline.clientHeight;
    if (linkTop < visibleTop || linkTop + active.link.offsetHeight > visibleBottom) {
      outline.scrollTop = linkTop - outline.clientHeight / 2;
    }
  };

  const setupOutline = () => {
    updateOutline();
    if (document.documentElement.dataset.docsOutlineReady !== "true") {
      document.documentElement.dataset.docsOutlineReady = "true";
      window.addEventListener("scroll", () => requestAnimationFrame(updateOutline), { passive: true });
    }
  };

  const setupAutoHideScrollbars = () => {
    if (document.documentElement.dataset.docsScrollbarReady === "true") return;
    document.documentElement.dataset.docsScrollbarReady = "true";
    const timers = new WeakMap<Element, number>();
    const reveal = (element: Element) => {
      element.setAttribute("data-scroll-active", "true");
      const previous = timers.get(element);
      if (previous) window.clearTimeout(previous);
      timers.set(element, window.setTimeout(() => {
        element.removeAttribute("data-scroll-active");
        timers.delete(element);
      }, 900));
    };
    window.addEventListener("scroll", () => reveal(document.documentElement), { passive: true });
    document.addEventListener("scroll", (event) => {
      if (event.target instanceof Element && event.target.matches(".next-docs__sidebar, .next-docs__outline, [data-docs-search-panel]")) {
        reveal(event.target);
      }
    }, { capture: true, passive: true });
  };

  setupOutline();
  setupAutoHideScrollbars();
  document.addEventListener("astro:page-load", setupOutline);

  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).catch(() => {
        // Routing remains fully functional when service workers are unavailable.
      });
    }, { once: true });
  }
</script>
