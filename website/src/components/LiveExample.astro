---
interface Props {
    title?: string;
    description?: string;
    compact?: boolean;
}

const {
    title = "Live preview",
    description,
    compact = false,
} = Astro.props;
---

<figure class:list={["live-example", { "live-example--compact": compact }]}>
    <figcaption class="live-example__header">
        <span>{title}</span>
        {description && <small>{description}</small>}
    </figcaption>
    <css-tags-example class="live-example__stage">
        <slot />
    </css-tags-example>
</figure>

<script>
    import "../scripts/css-tags-shadow";
</script>

<style>
    .live-example {
        --example-border: var(--outline-subtle, var(--border-color, #d8dee4));
        --example-surface: var(--surface-default, var(--bg-primary, #fff));
        --example-canvas: var(--surface-subtle, var(--bg-secondary, #f6f8fa));

        margin: 1rem 0 0.75rem;
        overflow: clip;
        border: 1px solid var(--example-border);
        border-radius: var(--radius-lg, 0.75rem);
        background: var(--example-surface);
    }

    .live-example__header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--example-border);
        background: var(--example-surface);
        color: var(--text-overt, var(--text-primary, inherit));
        font-size: var(--font-size-sm, 0.875rem);
        font-weight: var(--font-weight-semibold, 600);
    }

    .live-example__header small {
        color: var(--text-subtle, var(--text-secondary, inherit));
        font-size: inherit;
        font-weight: var(--font-weight-normal, 400);
    }

    .live-example__stage {
        display: block;
        container: live-example / inline-size;
        padding: clamp(0.75rem, 2.5cqi, 1.25rem);
        background:
            linear-gradient(var(--example-canvas), var(--example-canvas)) padding-box,
            var(--example-canvas);
    }

    .live-example--compact .live-example__stage {
        padding: 0.75rem;
    }

</style>
